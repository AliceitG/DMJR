# ---------------------------------------------------------------------------
# Knoten-Lookup
# ---------------------------------------------------------------------------

def find_by_attr(cur, attr_value: str):
    cur.execute("""
        SELECT a.pre, a.post, a.parent, a.kind, a.name
        FROM   accel     a
        JOIN   attribute t ON t.pre = a.pre
        WHERE  t.text = %s
        LIMIT 1
    """, (attr_value,))
    return cur.fetchone()


def find_by_content(cur, text: str):
    cur.execute("""
        SELECT a.pre, a.post, a.parent, a.kind, a.name
        FROM   accel   a
        JOIN   content c ON c.pre = a.pre
        WHERE  c.text = %s
        LIMIT 1
    """, (text,))
    return cur.fetchone()


# ---------------------------------------------------------------------------
# DB-Import
# ---------------------------------------------------------------------------

def import_to_db(conn, accel_rows, content_rows, attribute_rows):
    with conn.cursor() as cur:
        cur.execute("DELETE FROM attribute")
        cur.execute("DELETE FROM content")
        cur.execute("DELETE FROM accel")

        cur.executemany(
            "INSERT INTO accel (pre, post, parent, kind, name) VALUES (%s,%s,%s,%s,%s)",
            accel_rows
        )
        cur.executemany(
            "INSERT INTO content (pre, text) VALUES (%s,%s)",
            content_rows
        )
        cur.executemany(
            "INSERT INTO attribute (pre, text) VALUES (%s,%s)",
            attribute_rows
        )
    conn.commit()
    print(f"Import: {len(accel_rows)} accel, {len(content_rows)} content, {len(attribute_rows)} attribute Zeilen.")


# ---------------------------------------------------------------------------
# Baumhöhe
# ---------------------------------------------------------------------------

def tree_height(elem):
    children = list(elem)
    if not children:
        return 0
    return 1 + max(tree_height(child) for child in children)


# ---------------------------------------------------------------------------
# XPath-Achsen
# ---------------------------------------------------------------------------

def ancestor(cur, pre_v: int, post_v: int) -> list[tuple]:
    cur.execute("""
        SELECT pre, post, parent, kind, name
        FROM   accel
        WHERE  pre < %s AND post > %s
        ORDER  BY pre
    """, (pre_v, post_v))
    return cur.fetchall()


def descendant_original(cur, pre_v: int, post_v: int) -> list[tuple]:
    cur.execute("""
        SELECT pre, post, parent, kind, name
        FROM   accel
        WHERE  pre > %s AND post < %s
        ORDER  BY pre
    """, (pre_v, post_v))
    return cur.fetchall()


def descendant_optimized(cur, pre_v: int, post_v: int, height_t: int) -> list[tuple]:
    pre_upper = post_v + height_t
    post_lower = pre_v - height_t
    cur.execute("""
        SELECT pre, post, parent, kind, name
        FROM   accel
        WHERE  pre > %s
          AND  pre <= %s
          AND  post < %s
          AND  post >= %s
        ORDER  BY pre
    """, (pre_v, pre_upper, post_v, post_lower))
    return cur.fetchall()


def following_sibling(cur, pre_v: int, parent_v) -> list[tuple]:
    cur.execute("""
        SELECT pre, post, parent, kind, name
        FROM   accel
        WHERE  parent = %s AND pre > %s
        ORDER  BY pre
    """, (parent_v, pre_v))
    return cur.fetchall()


def preceding_sibling(cur, pre_v: int, parent_v) -> list[tuple]:
    cur.execute("""
        SELECT pre, post, parent, kind, name
        FROM   accel
        WHERE  parent = %s AND pre < %s
        ORDER  BY pre
    """, (parent_v, pre_v))
    return cur.fetchall()


# ---------------------------------------------------------------------------
# Ausgabe-Hilfe
# ---------------------------------------------------------------------------

def _fmt(rows: list[tuple]) -> str:
    if not rows:
        return "  (keine Ergebnisse)"
    return "\n".join(f"  pre={pre}, post={post}, parent={parent}, {kind} <{name}>" for pre, post, parent, kind, name in rows)


def _print(label: str, rows: list[tuple]) -> None:
    print(f"\n--- {label} (Größe={len(rows)}) ---")
    print(_fmt(rows))


# ---------------------------------------------------------------------------
# Korrektheitsnachweis für Punkt 1
# ---------------------------------------------------------------------------

def korrektheit_descendant(conn, pre_v: int, post_v: int, height_t: int):
    print("\n=== Punkt 1: Verkleinerung des Fensters für descendant ===")
    original = descendant_original(conn.cursor(), pre_v, post_v)
    optimized = descendant_optimized(conn.cursor(), pre_v, post_v, height_t)
    _print("descendant ORIGINAL", original)
    _print("descendant OPTIMIERT", optimized)
    print("\nErgebnis:", "Beide Ergebnisse sind äquivalent." if original == optimized else "Die Ergebnisse unterscheiden sich.")


